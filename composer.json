{
    "name": "omroepgelderland/phpstdlib",
    "description": "Shared PHP functions",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Remy Glaser",
            "email": "rglaser@gld.nl"
        }
    ],
    "minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"gldstdlib\\": "src/",
            "gldstdlib\\tests\\": "tests/"
		},
		"files": [
			"src/functions.php",
            "src/safe/curl.php",
            "src/safe/dir.php",
            "src/safe/fileinfo.php",
            "src/safe/filesystem.php",
            "src/safe/ftp.php",
            "src/safe/iconv.php",
            "src/safe/json.php",
            "src/safe/ldap.php",
            "src/safe/pcre.php"
		]
	},
    "require": {
        "php": ">=8.1 <8.6",
        "ext-date": "*",
        "ext-json": "*",
        "ext-pcre": "*",
        "aws/aws-sdk-php": "^3.389",
        "monolog/monolog": "^3.8",
        "catfan/medoo": "^2.1",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "phpmailer/phpmailer": "^7.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-ftp": "*",
        "ext-iconv": "*",
        "ext-ldap": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "google/apiclient": "^2.19"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^10.5",
        "omroepgelderland/php-coding-standard": "^1.0"
    }
}
